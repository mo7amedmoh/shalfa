{
  "name": "shalfa-school-facilities",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -b --pretty",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "vitest",
    "seed:kpi": "tsx scripts/seed-kpi.ts",
    "seed:kpi:database": "tsx scripts/seed-kpi-database.ts",
    "seed:checklist": "tsx scripts/seed-checklist.ts",
    "seed:deliverables": "tsx scripts/seed-deliverables.ts",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "verify:schema": "tsx scripts/verify-schema.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "5.2.6",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.66.9",
    "@tanstack/react-query-persist-client": "^5.66.9",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "papaparse": "5.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-leaflet": "4.2.1",
    "react-leaflet-cluster": "2.1.0",
    "react-router-dom": "7.18.5",
    "recharts": "2.15.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/leaflet": "1.9.16",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "playwright": "^1.64.1",
    "postcss": "8.5.32",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
